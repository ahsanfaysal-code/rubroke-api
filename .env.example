# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=5000

# --- Auth ---
# Required in every environment. Generate a long random value; never use a default.
JWT_SECRET=""

# Required to create the initial administrator account. These are never given defaults.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Funding / Stripe (optional) ---
# When set, "Help This Business" creates a real Stripe Checkout session.
# When unset, pledges run in demo mode (recorded instantly, no payment).
STRIPE_SECRET_KEY=""

# When set alongside STRIPE_SECRET_KEY, live payment confirmations are verified
# via Stripe's webhook (install the `stripe` package for this to take effect).
STRIPE_WEBHOOK_SECRET=""

# Public URL of the client app (used for Stripe success/cancel redirects).
APP_URL="http://localhost:4000"

# --- Google OAuth (optional) ---
# When set to a real client ID, Google login tokens are signature-verified.
# When empty, Google login is unavailable.
# This is the Web-client OAuth Client ID from the GCP "rubroke" project.
GOOGLE_CLIENT_ID="863137280417-89sckc7nvlqlmurmft4a2mcjsgask1kk.apps.googleusercontent.com"

# --- Gemini (server-side only) ---
# Never expose this value through VITE_ variables or browser code.
GEMINI_API_KEY=""

# --- Cloudflare Turnstile (bot / abuse protection) ---
# Public site key embedded in the client (safe to expose). Get from
# Cloudflare dashboard -> Turnstile -> your widget -> Site Key.
TURNSTILE_SITE_KEY=""

# Secret key used by the server to verify Turnstile tokens. Get from
# Cloudflare dashboard -> Turnstile -> your widget -> Secret Key.
# When empty, verification is skipped (dev mode).
TURNSTILE_SECRET_KEY=""
